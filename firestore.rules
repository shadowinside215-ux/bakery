rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "dragonballsam86@gmail.com" ||
        request.auth.token.email_verified == true && request.auth.token.email == "dragonballsam86@gmail.com"
      );
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow create: if isAdmin() && 
                      request.resource.data.keys().hasAll(['url', 'createdAt']) &&
                      request.resource.data.url is string &&
                      request.resource.data.url.size() < 1000;
      allow delete: if isAdmin();
      allow update: if isAdmin(); // Allow updating name/price
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
